{
  "name": "task",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-catalog-images.mjs && node --import ./set-polyfill.mjs ./node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node scripts/generate-catalog-images.mjs && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "node --import ./set-polyfill.mjs ./node_modules/nuxt/bin/nuxt.mjs typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.10.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  }
}
